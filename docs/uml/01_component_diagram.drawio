<mxfile host="app.diagrams.net" version="21.0.0"><diagram id="diag1" name="Component Diagram"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="100" parent="1" vertex="1" value="&lt;b&gt;Global Federated Server (Trusted Central Aggregator)&lt;/b&gt;" style="rounded=1;fillColor=#F0F4F8;strokeColor=#1A5FB4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=20;spacingTop=12;fontColor=#0A2540;fontSize=14;fontStyle=1;html=1;whiteSpace=wrap;"><mxGeometry x="340" y="40" width="960" height="240" as="geometry" /></mxCell><mxCell id="101" parent="1" vertex="1" value="&lt;b&gt;Global Classifier (F_θ)&lt;/b&gt;&lt;br&gt;ResNet-18 / ConvNet Backbone&lt;br&gt;128-dim Latent Embeddings" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#0A2540;fontSize=12;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="370" y="90" width="260" height="75" as="geometry" /></mxCell><mxCell id="102" parent="1" vertex="1" value="&lt;b&gt;Global Conditional Generator (G_ψ)&lt;/b&gt;&lt;br&gt;Latent Distribution Model&lt;br&gt;p(f | y=IPF, COPD, Normal)" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#0A2540;fontSize=12;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="680" y="90" width="270" height="75" as="geometry" /></mxCell><mxCell id="103" parent="1" vertex="1" value="&lt;b&gt;Federated Parameter Aggregator&lt;/b&gt;&lt;br&gt;θ_glob = Σ (n_k/N) θ_k&lt;br&gt;ψ_glob = Σ (n_k/N) ψ_k" style="rounded=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#0A2540;fontSize=12;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="990" y="90" width="280" height="75" as="geometry" /></mxCell><mxCell id="104" parent="1" vertex="1" value="&lt;b&gt;Federated Orchestration &amp;amp; Evaluation Engine&lt;/b&gt;&lt;br&gt;Round Scheduling • Convergence Check • Multi-Center Test Evaluation (BACC, Recall, AUROC)" style="rounded=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#0A2540;fontSize=12;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="480" y="185" width="680" height="65" as="geometry" /></mxCell><mxCell id="150" parent="1" vertex="1" value="&lt;b&gt;SECURE ENCRYPTED NETWORK BOUNDARY (Zero Raw Data Leakage — Parameters &amp;amp; Latents Only)&lt;/b&gt;" style="rounded=1;fillColor=#FFF8E1;strokeColor=#FFA000;strokeWidth=2;dashed=1;fontColor=#B78103;fontSize=13;fontStyle=1;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="80" y="315" width="1480" height="45" as="geometry" /></mxCell><mxCell id="200" parent="1" vertex="1" value="&lt;b&gt;Hospital 1: Tertiary Medical Center&lt;/b&gt; [Balanced, High IPF Cases]" style="rounded=1;fillColor=#F8FAFC;strokeColor=#1A5FB4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#0A2540;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;"><mxGeometry x="80" y="390" width="460" height="530" as="geometry" /></mxCell><mxCell id="201" parent="1" vertex="1" value="&lt;b&gt;Private HRCT Dataset&lt;/b&gt;&lt;br&gt;33 IPF | 72 COPD | 296 Norm&lt;br&gt;Siemens Somatom Scanner" style="shape=cylinder3;size=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="105" y="445" width="200" height="80" as="geometry" /></mxCell><mxCell id="202" parent="1" vertex="1" value="&lt;b&gt;Local Classifier (F_θ_1)&lt;/b&gt;&lt;br&gt;Extracts 128-d features&lt;br&gt;Computes Real Centroids" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="325" y="445" width="190" height="80" as="geometry" /></mxCell><mxCell id="203" parent="1" vertex="1" value="&lt;b&gt;Local Generator Distillation (G_ψ_1)&lt;/b&gt;&lt;br&gt;Multi-Task Loss: L_CE + λ_fm L_FM - λ_div L_DIV&lt;br&gt;Anchored to local real IPF centroids" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="105" y="550" width="410" height="70" as="geometry" /></mxCell><mxCell id="204" parent="1" vertex="1" value="&lt;b&gt;Generative Latent Replay Engine&lt;/b&gt;&lt;br&gt;Balances mini-batches on-the-fly&lt;br&gt;f_comb = Concat[f_real, f̂_IPF]" style="rounded=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="105" y="645" width="410" height="70" as="geometry" /></mxCell><mxCell id="205" parent="1" vertex="1" value="&lt;b&gt;Hospital 1 Federated Client Node&lt;/b&gt;&lt;br&gt;Receives (θ, ψ) • Computes (Δθ_1, Δψ_1) • Secure Upload" style="rounded=1;fillColor=#EBF3FB;strokeColor=#1A5FB4;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="105" y="740" width="410" height="65" as="geometry" /></mxCell><mxCell id="300" parent="1" vertex="1" value="&lt;b&gt;Hospital 2: Community Clinic&lt;/b&gt; [Zero IPF Cases — True Rare Scarcity]" style="rounded=1;fillColor=#FDF2E9;strokeColor=#E67E22;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#0A2540;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;"><mxGeometry x="590" y="390" width="460" height="530" as="geometry" /></mxCell><mxCell id="301" parent="1" vertex="1" value="&lt;b&gt;Private HRCT Dataset&lt;/b&gt;&lt;br&gt;&lt;b&gt;0 IPF&lt;/b&gt; | 21 COPD | 150 Norm&lt;br&gt;GE LightSpeed Scanner" style="shape=cylinder3;size=15;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="615" y="445" width="200" height="80" as="geometry" /></mxCell><mxCell id="302" parent="1" vertex="1" value="&lt;b&gt;Local Classifier (F_θ_2)&lt;/b&gt;&lt;br&gt;No Real IPF Training Scans&lt;br&gt;Prone to class collapse" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="835" y="445" width="190" height="80" as="geometry" /></mxCell><mxCell id="303" parent="1" vertex="1" value="&lt;b&gt;Zero-Patient Distillation Adapter&lt;/b&gt;&lt;br&gt;Distills G_ψ using global class prototypes&lt;br&gt;No division-by-zero errors" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="615" y="550" width="410" height="70" as="geometry" /></mxCell><mxCell id="304" parent="1" vertex="1" value="&lt;b&gt;Generative Latent Replay Engine&lt;/b&gt;&lt;br&gt;&lt;b&gt;Synthesizes 100% of Rare IPF Latents!&lt;/b&gt;&lt;br&gt;Restores balanced gradient signal" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#0A2540;fontSize=11;fontStyle=1;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="615" y="645" width="410" height="70" as="geometry" /></mxCell><mxCell id="305" parent="1" vertex="1" value="&lt;b&gt;Hospital 2 Federated Client Node&lt;/b&gt;&lt;br&gt;Receives (θ, ψ) • Computes (Δθ_2, Δψ_2) • Secure Upload" style="rounded=1;fillColor=#FDF2E9;strokeColor=#E67E22;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="615" y="740" width="410" height="65" as="geometry" /></mxCell><mxCell id="400" parent="1" vertex="1" value="&lt;b&gt;Hospital 3: Rural District Hospital&lt;/b&gt; [1 IPF Patient — Single Anchor]" style="rounded=1;fillColor=#F5F7FA;strokeColor=#1A5FB4;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#0A2540;fontSize=13;fontStyle=1;html=1;whiteSpace=wrap;"><mxGeometry x="1100" y="390" width="460" height="530" as="geometry" /></mxCell><mxCell id="401" parent="1" vertex="1" value="&lt;b&gt;Private HRCT Dataset&lt;/b&gt;&lt;br&gt;&lt;b&gt;1 IPF&lt;/b&gt; | 142 COPD | 80 Norm&lt;br&gt;Philips Ingenuity Scanner" style="shape=cylinder3;size=15;fillColor=#FFE6CC;strokeColor=#D79B00;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="1125" y="445" width="200" height="80" as="geometry" /></mxCell><mxCell id="402" parent="1" vertex="1" value="&lt;b&gt;Local Classifier (F_θ_3)&lt;/b&gt;&lt;br&gt;Single IPF anchor instance&lt;br&gt;IntraSCL cannot form pairs" style="rounded=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="1345" y="445" width="190" height="80" as="geometry" /></mxCell><mxCell id="403" parent="1" vertex="1" value="&lt;b&gt;FedIIC IntraSCL Failure Point&lt;/b&gt;&lt;br&gt;|P(i)| = 0 positive pairs → Contrastive Collapse&lt;br&gt;DALA prior log(0) → -∞ penalty" style="rounded=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="1125" y="550" width="410" height="70" as="geometry" /></mxCell><mxCell id="404" parent="1" vertex="1" value="&lt;b&gt;Generative Latent Replay Solution&lt;/b&gt;&lt;br&gt;Supplies synthetic positive pairs for IntraSCL&lt;br&gt;Eliminates negative DALA bias" style="rounded=1;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#0A2540;fontSize=11;fontStyle=1;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="1125" y="645" width="410" height="70" as="geometry" /></mxCell><mxCell id="405" parent="1" vertex="1" value="&lt;b&gt;Hospital 3 Federated Client Node&lt;/b&gt;&lt;br&gt;Receives (θ, ψ) • Computes (Δθ_3, Δψ_3) • Secure Upload" style="rounded=1;fillColor=#EBF3FB;strokeColor=#1A5FB4;fontColor=#0A2540;fontSize=11;align=center;html=1;whiteSpace=wrap;"><mxGeometry x="1125" y="740" width="410" height="65" as="geometry" /></mxCell><mxCell id="501" parent="1" edge="1" source="104" target="205" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1A5FB4;strokeWidth=2;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" value="Broadcast (θ, ψ)"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="502" parent="1" edge="1" source="104" target="305" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#1A5FB4;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;ent