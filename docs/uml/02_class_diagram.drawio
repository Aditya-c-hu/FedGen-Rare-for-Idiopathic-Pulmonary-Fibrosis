<mxfile host="app.diagrams.net" version="21.0.0"><diagram id="diag1" name="Class Diagram"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="10" parent="1" vertex="1" value="&lt;b&gt;Config&lt;/b&gt;&lt;br&gt;+ disease_target: str = 'IPF'&lt;br&gt;+ num_classes: int = 3&lt;br&gt;+ rare_class_idx: int = 0&lt;br&gt;+ num_clients: int = 5&lt;br&gt;+ non_iid_alpha: float = 0.2&lt;br&gt;+ global_rounds: int = 12&lt;br&gt;+ feature_dim: int = 128&lt;br&gt;+ noise_dim: int = 64&lt;br&gt;+ to_dict(): dict" style="swimlane;fontStyle=0;align=center;verticalAlign=top;startSize=28;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#0A2540;fontSize=12;html=1;whiteSpace=wrap;"><mxGeometry x="60" y="50" width="320" height="260" as="geometry" /></mxCell><mxCell id="20" parent="1" vertex="1" value="&lt;b&gt;IPFChestCTDataset&lt;/b&gt;&lt;br&gt;+ images: Tensor[N, 1, 64, 64]&lt;br&gt;+ labels: Tensor[N]&lt;br&gt;+ scanner_ids: Tensor[N]&lt;br&gt;+ class_counts: list[int]&lt;br&gt;+ __len__(): int&lt;br&gt;+ __getitem__(idx: int): tuple[Tensor, int]&lt;br&gt;+ get_class_counts(): list[int]&lt;br&gt;+ get_scanner_distribution(): dict" style="swimlane;fontStyle=0;align=center;verticalAlign=top;startSize=28;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#0A2540;fontSize=12;html=1;whiteSpace=wrap;"><mxGeometry x="440" y="50" width="360" height="260" as="geometry" /></mxCell><mxCell id="30" parent="1" vertex="1" value="&lt;b&gt;ConditionalFeatureGenerator&lt;/b&gt;&lt;br&gt;- label_embed: nn.Embedding(3, 64)&lt;br&gt;- mlp_layers: nn.Sequential&lt;br&gt;+ forward(noise: Tensor, labels: Tensor): Tensor&lt;br&gt;+ sample(labels: Tensor, device: str): Tensor&lt;br&gt;+ compute_diversity_loss(z1, z2): Tensor" style="swimlane;fontStyle=0;align=center;verticalAlign=top;startSize=28;fillColor=#D5E8D