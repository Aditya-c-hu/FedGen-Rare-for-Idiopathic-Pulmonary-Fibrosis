ls.resnet18&lt;br&gt;- custom_fc: nn.Linear(512, 128)&lt;br&gt;- classifier_head: nn.Linear(128, 3)&lt;br&gt;- projector_head: nn.Sequential(128 -&gt; 64)&lt;br&gt;+ extract_features(x: Tensor): Tensor&lt;br&gt;+ forward_head(feat: Tensor): Tensor" style="swimlane;fontStyle=0;align=center;verticalAlign=top;startSize=28;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#0A2540;fontSize=12;html=1;whiteSpace=wrap;"><mxGeometry x="640" y="620" width="360" height="220" as="geometry" /></mxCell><mxCell id="60" parent="1" vertex="1" value="&lt;b&gt;HospitalClient&lt;/b&gt;&lt;br&gt;+ client_id: int&lt;br&gt;+ dataset: IPFChestCTDataset&lt;br&gt;+ total_samples: int&lt;br&gt;+ rare_samples: int&lt;br&gt;+ local_classifier: BaseClassifier&lt;br&gt;+ local_generator: ConditionalFeatureGenerator&lt;br&gt;+ train_classifier_standard(): tuple[dict, float]&lt;br&gt;+ train_classifier_fediic(): tuple[dict, float]&lt;br&gt;+ train_classifier_with_replay(): tuple[dict, float]&lt;br&gt;+ train_generator_locally(): tuple[dict, float]&lt;br&gt;+ compute_real_feature_centroids(): dict[int, Tensor]" style="swimlane;fontStyle=0;align=center;verticalAlign=top;startSize=28;fillColor=#F5F7FA;strokeColor=#1A5FB4;fontColor=#0A2540;fontSize=12;html=1;whiteSpace=wrap;"><mxGeometry x="1080" y="380" width="480" height="330" as="geometry" /></mxCell><mxCell id="70" parent="1" vertex="1" value="&lt;b&gt;FederatedServer&lt;/b&gt;&lt;br&gt;+ clients: list[HospitalClient]&lt;br&gt;+ test_dataset: IPFChestCTDataset&lt;br&gt;+ global_classifier: BaseClassifier&lt;br&gt;+ global_generator: ConditionalFeatureGenerator&lt;br&gt;+ aggregate_weights(weights_list, sample_weights): dict&lt;br&gt;+ train_round_fedavg(): float&lt;br&gt;+ train_round_fedprox(mu: float): float&lt;br&gt;+ train_round_fediic(): float&lt;br&gt;+ train_round_fedgen_rare(): float&lt;br&gt;+ evaluate_global(classifier): dict[str, float]" style="swimlane;fontStyle=0;align=center;verticalAlign=top;startSize=28;fillColor=#EBF3FB;strokeColor=#